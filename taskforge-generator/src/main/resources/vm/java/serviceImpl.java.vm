        if (${className} == null) {
            ${className} = new ${ClassName}();
        }
        LambdaQueryWrapper<${ClassName}> qw = new LambdaQueryWrapper<>();
#foreach ($column in $columns)
#if($column.isQuery == '1')
#set($getter = "${className}.get${column.capJavaField}()")
#if($column.javaType == 'String')
#set($condition = "StringUtils.hasText($getter)")
#else
#set($condition = "$getter != null")
#end
#if($column.queryType == 'LIKE')
#set($op = 'like')
#elseif($column.queryType == 'NE')
#set($op = 'ne')
#elseif($column.queryType == 'GT')
#set($op = 'gt')
#elseif($column.queryType == 'GTE')
